# ==========================================
# SportIS - Environment Configuration
# ==========================================

# Application URL (base URL without trailing slash)
# For local Docker setup: http://localhost:8080
# For local XAMPP setup: http://localhost/LocalGreetings/public
# For cloud deployment: https://your-domain.com
APP_URL=http://localhost:8080

# Database Configuration
MYSQL_SERVER=127.0.0.1
MYSQL_USER=sportis_user
MYSQL_PASSWORD=sportis_pass
MYSQL_DB=sportis
MYSQL_PORT=3306

# Mail Configuration (Optional - for RSS email notifications via Gmail SMTP)
MAIL_ADDRESS=
MAIL_PASSWORD=
